<Window x:Class="BsxtBatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BsxtBatch.App.Converters"
        Title="BsxtBatch — run the Photoshop BSXT action on a pile of files"
        Icon="backscatter-fish.ico"
        Width="980" Height="680" MinWidth="720" MinHeight="480"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="100" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Add Files…"    Command="{Binding AddFilesCommand}"    Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Add Folder…"   Command="{Binding AddFolderCommand}"   Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Remove Selected" Command="{Binding RemoveSelectedCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Clear List"    Command="{Binding ClearListCommand}"   Padding="12,4" />
        </StackPanel>

        <!-- Input filter + export format options -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Process:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding InputModeOptions}"
                      SelectedItem="{Binding SelectedInputMode}"
                      DisplayMemberPath="Label"
                      IsEnabled="{Binding CanEditSettings}"
                      Width="128"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0"
                      ToolTip="Which source files to open. Both includes RAW, JPEG, TIFF, and PSD. RAWs only and JPGs only skip the rest." />
            <TextBlock Text="Export:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" />
            <CheckBox Content="JPG" IsChecked="{Binding ExportJpg}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <CheckBox Content="TIF" IsChecked="{Binding ExportTiff}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <CheckBox Content="PSD (with layers)" IsChecked="{Binding ExportPsd}" VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Saves a layered Photoshop copy — the BSXT action's layers are preserved." />
            <TextBlock VerticalAlignment="Center" Foreground="#C00000" FontWeight="SemiBold"
                       Text="Select at least one export format!">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasExportFormatSelected}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Output folder override -->
        <DockPanel Grid.Row="2" Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Output folder:" VerticalAlignment="Center"
                       FontWeight="Bold" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearOutputFolderCommand}"
                    Padding="10,3" Margin="8,0,0,0" ToolTip="Back to: same folder as each source file" />
            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseOutputFolderCommand}"
                    Padding="10,3" />
            <TextBox Text="{Binding OutputFolderDisplay, Mode=OneWay}" IsReadOnly="True"
                     VerticalAlignment="Center" Background="Transparent" BorderBrush="#DDDDDD"
                     Padding="4,2" ToolTip="Outputs go to this folder; default is each file's own folder." />
        </DockPanel>

        <!-- Hint -->
        <TextBlock Grid.Row="3" Margin="0,8,0,8" Foreground="Gray" TextWrapping="Wrap"
                   Text="Drop files or folders anywhere in this window. Folders include every subfolder; the list shows the path relative to the folder you added, and each result is written next to its source file (or into the output folder above when that is set). Process chooses RAWs only, JPGs only, or both (both also includes TIFF and PSD). Exports are photo-BSXT.tif / .jpg / .psd for the formats selected above; PSD copies keep the action's layers. Originals are never modified and existing files are never overwritten. If Photoshop hangs (no finish within 50 minutes) or quits, it is restarted and that file is retried up to 5 times. Files that already contain BSXT/Cleanup layers are skipped." />

        <!-- Job list -->
        <ListView Grid.Row="4" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding SourcePath}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Kind" Width="70" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="Status" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Detail" Width="440">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Progress + run controls -->
        <DockPanel Grid.Row="5" Margin="0,10,0,10">
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}"
                    Padding="14,4" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="▶  Run BSXT Batch" Command="{Binding RunCommand}"
                    Padding="14,4" FontWeight="Bold" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" VerticalAlignment="Center"
                           Margin="8,0,12,0" MinWidth="64" TextAlignment="Right" />
                <!-- ProgressBar.Value defaults to TwoWay; ProgressPercent is read-only, so pin OneWay -->
                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="18"
                             VerticalAlignment="Center" />
            </DockPanel>
        </DockPanel>

        <!-- Log -->
        <ListBox Grid.Row="6" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="LogBox" />
    </Grid>
</Window>
